model Contrato {
  id               String  @id @default(cuid())
  contaId          String
  matriculaId      String
  modeloId         String? // Referência ao modelo de contrato usado
  contratoOrigemId String?

  // PDF apresentado ao assinante. Mantido por compatibilidade com o fluxo legado.
  arquivoPdfUrl               String
  hashPdf                     String
  arquivoPdfAssinadoUrl       String?
  hashPdfAssinado             String?
  // Snapshot imutável dos campos usados neste contrato no momento da geração.
  camposAssinaturaSnapshot    Json?
  // Snapshot e decisões de consentimento apresentados/registrados neste contrato.
  termosConsentimentoSnapshot Json?
  decisoesConsentimento       Json?

  // @deprecated - Campo legado para migração
  conteudoFinal String? @db.Text // HTML renderizado (contratos antigos)
  templateId    String? // Referência legada

  status StatusAssinatura @default(PENDENTE)

  // Dados da assinatura eletrônica
  assinadoPor            String? // Nome de quem assinou
  assinadoEmail          String? // Email
  assinadoCpf            String? // CPF (validado)
  assinadoDataNascimento DateTime? // Data de nascimento informada no momento da assinatura
  assinadoIp             String? // IP da assinatura
  assinadoEm             DateTime? // Timestamp
  assinadoUserAgent      String? // Navegador/device
  hashAssinatura         String? // SHA-256 do PDF + dados da assinatura

  // Link de compartilhamento
  tokenPublico     String    @unique @default(cuid()) // @deprecated: manter somente para fallback legado.
  tokenPublicoHash String?
  // Token cifrado para permitir entrega assíncrona do link sem persistir o valor em claro.
  tokenPublicoCriptografado String?
  tokenExpiraEm    DateTime? // Expiração do link (padrão: 7 dias)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conta                     Conta               @relation(fields: [contaId], references: [id], onDelete: Restrict)
  matricula                 Matricula           @relation("MatriculaContratos", fields: [matriculaId], references: [id], onDelete: Restrict)
  modelo                    ContratoModelo?     @relation(fields: [modeloId], references: [id])
  contratoOrigem            Contrato?           @relation("ContratoAditivo", fields: [contratoOrigemId], references: [id])
  aditivos                  Contrato[]          @relation("ContratoAditivo")
  matriculaContratoAtual    Matricula?          @relation("MatriculaContratoAtual")
  subscriptions             Subscription[]
  installmentPlans          InstallmentPlan[]
  evidencias                ContractEvidence[]
  signatureOtps             ContractSignatureOtp[]
  documentos                ContratoDocumento[]
  whatsappNotifications     ContractWhatsAppNotification[]
  rematriculaContratoFuturo ContratoFuturo?

  @@index([contaId, status], name: "idx_contrato_conta_status")
  @@index([contaId, matriculaId], name: "idx_contrato_conta_matricula")
  @@index([contaId, createdAt], name: "idx_contrato_conta_created")
  @@index([contaId, tokenPublicoHash], name: "idx_contrato_conta_token_hash")
  @@index([matriculaId], name: "idx_contrato_matricula")
  @@index([modeloId], name: "idx_contrato_modelo")
  @@index([status], name: "idx_contrato_status")
  @@index([tokenPublico], name: "idx_contrato_token")
  @@index([tokenPublicoHash], name: "idx_contrato_token_hash")
  @@index([tokenExpiraEm], name: "idx_contrato_token_expira")
  @@index([status, matriculaId], name: "idx_contrato_status_matricula")
}

model ContractWhatsAppNotification {
  id                String                              @id @default(cuid())
  contaId           String
  contratoId        String
  matriculaId       String
  status            ContractWhatsAppNotificationStatus @default(PENDING)
  templateName      String
