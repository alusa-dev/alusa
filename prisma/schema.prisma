  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([contaId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([correlationId])
