// Contratos operacionais gerados para a participação de um aluno em um evento.
// Mantido separado de Contrato para não alterar o ciclo de vida acadêmico da matrícula.
model EventoContrato {
  id                          String           @id @default(cuid())
  contaId                     String
  eventId                     String
  participantId               String
  alunoId                     String
  responsavelId               String?
  modeloId                    String
  arquivoPdfUrl               String
  hashPdf                     String
  arquivoPdfAssinadoUrl       String?
  hashPdfAssinado             String?
  camposAssinaturaSnapshot    Json?
  termosConsentimentoSnapshot Json?
  decisoesConsentimento       Json?
  status                      StatusAssinatura @default(PENDENTE)
  assinadoPor                 String?
  assinadoEmail               String?
  assinadoCpf                 String?
  assinadoDataNascimento      DateTime?
  assinadoIp                  String?
  assinadoEm                  DateTime?
  assinadoUserAgent           String?
  hashAssinatura              String?
  tokenPublico                String           @unique @default(cuid())
  tokenPublicoHash            String?
  tokenExpiraEm               DateTime?
  createdByUserId             String?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  conta       Conta                     @relation(fields: [contaId], references: [id], onDelete: Restrict)
