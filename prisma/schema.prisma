model Charge {
  id      String @id @default(cuid())
  contaId String

  cobrancaId String? @unique

  externalReference String @unique

  status          ChargeStatus @default(CREATED)
  statusUpdatedAt DateTime     @default(now())

  asaasPaymentId String? @unique

  // Snapshot Asaas - usado para exibir o status oficial da cobranca
  asaasStatus              String?
  asaasValue               Decimal?         @db.Decimal(12, 2)
  asaasNetValue            Decimal?         @db.Decimal(12, 2)
  asaasOriginalValue       Decimal?         @db.Decimal(12, 2)
  asaasFeeValue            Decimal?         @db.Decimal(12, 2)
  asaasCreditDate          DateTime?
  asaasEstimatedCreditDate DateTime?
  lastAsaasFetchAt         DateTime?
  liquidacaoStatus         LiquidacaoStatus @default(NAO_APLICAVEL)
  liquidadoEm              DateTime?

  // Fase 4: dimensões separadas da máquina de estados financeira.
  providerStatus       String?
  processingStatus     String    @default("PENDING")
  reconciliationStatus String    @default("UNKNOWN")
  providerUpdatedAt    DateTime?
  lastWebhookAt        DateTime?
  lastProviderCheckAt  DateTime?
  lastReconciledAt     DateTime?
  lastAppliedEventId   String?
  localStateUpdatedAt  DateTime?
  version              Int       @default(0)

  // Campos para listagem de standalone charges (sem vínculo com Cobranca)
  // Preenchidos na criação para evitar consultas externas
  payerName     String? // Nome do pagador (aluno ou responsável)
  description   String? // Descrição da cobrança
  value         Decimal?  @db.Decimal(12, 2) // Valor da cobrança
  dueDate       DateTime? // Data de vencimento
  billingType   String? // PIX, BOLETO, CREDIT_CARD, etc.
  customerId    String? // ID do Customer local (para referência)
  invoiceUrl    String? // Link de pagamento (invoiceUrl do Asaas)
  familyGroupId String?

  // Snapshot das regras aplicadas no momento da emissão.
  // Não deve ser recalculado a partir da configuração atual do evento.
  interestValue            Decimal? @db.Decimal(12, 2)
  fineValue                Decimal? @db.Decimal(12, 2)
  fineType                 String?
  discountValue            Decimal? @db.Decimal(12, 2)
  discountType             String?
  discountDueDateLimitDays Int?

  standaloneInstallmentPlanId String?
  standaloneSubscriptionId    String?

  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conta                      Conta                       @relation(fields: [contaId], references: [id], onDelete: Restrict)
  cobranca                   Cobranca?                   @relation(fields: [cobrancaId], references: [id], onDelete: SetNull)
  customer                   Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  standaloneInstallmentPlan  StandaloneInstallmentPlan?  @relation(fields: [standaloneInstallmentPlanId], references: [id], onDelete: SetNull)
  standaloneSubscription     StandaloneSubscription?     @relation(fields: [standaloneSubscriptionId], references: [id], onDelete: SetNull)
  arquivos                   ArquivoCharge[]
  asaasIntegrationJobs       AsaasIntegrationJob[]
  familyFinancialAllocations FamilyFinancialAllocation[]
  billingAdjustments         BillingAdjustment[]
  billingAllocations         BillingAllocation[]
  sale                       Sale?

  @@unique([contaId, id], name: "uq_charge_conta_id")
  @@unique([contaId, asaasPaymentId], name: "uq_charge_conta_asaas_payment")
  @@index([contaId])
  @@index([status])
  @@index([contaId, status, dueDate], name: "idx_charge_conta_status_due")
  @@index([contaId, standaloneInstallmentPlanId, dueDate], name: "idx_charge_conta_plan_due")
  @@index([contaId, createdAt], name: "idx_charge_conta_created")
  @@index([contaId, status, createdAt], name: "idx_charge_conta_status_created")
  @@index([contaId, asaasStatus], name: "idx_charge_conta_asaas_status")
  @@index([contaId, liquidacaoStatus], name: "idx_charge_conta_liquidacao")
  @@index([asaasPaymentId])
  @@index([customerId])
  @@index([standaloneInstallmentPlanId])
  @@index([standaloneSubscriptionId])
  @@index([familyGroupId])
  @@index([contaId, lastProviderCheckAt, status], name: "idx_charge_conta_provider_check")
}

