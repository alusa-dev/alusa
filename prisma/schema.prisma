  @@index([contaId, eventId, status], name: "idx_evento_contrato_conta_evento_status")
  @@index([contaId, tokenPublicoHash], name: "idx_evento_contrato_conta_token_hash")
  @@index([contaId, createdAt], name: "idx_evento_contrato_conta_created")
