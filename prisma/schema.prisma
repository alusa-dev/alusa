model Notification {
  id          String               @id @default(cuid())
  contaId     String
  type        NotificationType
  category    NotificationCategory
  severity    NotificationSeverity @default(INFO)
  title       String
  message     String
  dedupeKey   String
  relatedPath String?
  entityType  String?
  entityId    String?
  sourceType  String?
  sourceId    String?
  actorType   AuditActorType?
  actorId     String?
  metadata    Json?
  triggeredAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  conta        Conta                     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  recipients   NotificationRecipient[]
  digestEvents NotificationDigestEvent[]

  @@unique([contaId, dedupeKey])
  @@index([contaId, triggeredAt])
  @@index([contaId, type, createdAt], name: "idx_notification_conta_type_created")
  @@index([contaId, category, createdAt], name: "idx_notification_conta_category_created")
  @@index([contaId, severity, createdAt], name: "idx_notification_conta_severity_created")
  @@index([contaId, sourceType, sourceId], name: "idx_notification_conta_source")
  @@index([contaId, entityType, entityId], name: "idx_notification_conta_entity")
  @@index([type])
  @@index([entityType, entityId])
}

model NotificationRecipient {
  id             String    @id @default(cuid())
  notificationId String
  contaId        String
  userId         String
  readAt         DateTime?
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  user         Usuario      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([contaId, userId, archivedAt, readAt])
  @@index([contaId, userId, archivedAt, createdAt], name: "idx_notification_recipient_feed")
  @@index([contaId, userId, readAt], name: "idx_notification_recipient_read")
  @@index([contaId, userId, archivedAt, readAt, createdAt], name: "idx_notification_recipient_unread_feed")
  @@index([contaId, userId, deletedAt, archivedAt, createdAt], name: "idx_notification_recipient_deleted_feed")
  @@index([userId, createdAt])
}

model NotificationDigestEvent {
  id             String   @id @default(cuid())
  notificationId String
  contaId        String
  eventKey       String
  createdAt      DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@unique([contaId, eventKey], name: "uq_notification_digest_event_conta_event")
  @@index([contaId, notificationId], name: "idx_notification_digest_event_conta_notification")
}

/// Fila de retry para notificações internas quando a entidade local ainda não existe.
model PendingInboxNotification {
  id                  String                         @id @default(cuid())
  contaId             String?
  kind                String
  payload             Json
  dedupeKey           String                         @unique
  status              PendingInboxNotificationStatus @default(PENDING)
  attempts            Int                            @default(0)
  maxAttempts         Int                            @default(5)
  nextRetryAt         DateTime                       @default(now())
  processingToken     String?
  processingStartedAt DateTime?
  leaseUntil          DateTime?
  lastError           String?
  createdAt           DateTime                       @default(now())
  processedAt         DateTime?

  @@index([status, nextRetryAt])
  @@index([contaId, status, nextRetryAt])
  @@index([status, leaseUntil])
}

