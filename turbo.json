{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalDependencies": [
    ".npmrc",
    ".vercelignore",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "tsconfig.base.json",
    "eslint.config.js",
    "prisma/schema.prisma",
    "prisma/migrations/**",
    "scripts/vercel-ignore-build.mjs"
  ],
  "tasks": {
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"],
      "cache": true
    },
    "test": {
      "outputs": []
    },
    "e2e": {
      "outputs": []
    }
  }
}
