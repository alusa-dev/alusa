{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "workspace:check",
			"type": "shell",
			"command": "pnpm workspace:check",
			"problemMatcher": []
		},
		{
			"label": "typecheck:workspace",
			"type": "shell",
			"command": "pnpm typecheck",
			"problemMatcher": ["$tsc"],
			"group": { "kind": "test", "isDefault": true }
		},
		{
			"label": "lint:workspace",
			"type": "shell",
			"command": "pnpm lint:check",
			"problemMatcher": []
		},
		{
			"label": "test:unit:web",
			"type": "shell",
			"command": "pnpm test:unit",
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "test:critical-gates",
			"type": "shell",
			"command": "pnpm security:check && pnpm audit:dtos && pnpm audit:route-boundaries && pnpm audit:route-sizes && pnpm audit:route-inventory && pnpm audit:api-canonicalization && pnpm audit:package-graph",
			"problemMatcher": [],
			"group": "test"
		}
	]
}
