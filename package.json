{
  "name": "alusa-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "workspace:check": "node scripts/check-workspace.mjs",
    "audit:dtos": "node scripts/audit-dto-usage.mjs",
    "audit:route-boundaries": "node scripts/audit-route-boundaries.mjs",
    "audit:route-sizes": "node scripts/audit-route-sizes.mjs",
    "audit:route-inventory": "node scripts/audit-route-inventory.mjs",
    "audit:critical-route-coverage": "node scripts/audit-critical-route-coverage.mjs",
    "audit:api-canonicalization": "node scripts/audit-api-canonicalization.mjs",
    "audit:http-contracts": "node scripts/audit-http-contracts.mjs",
    "audit:rate-limit": "node scripts/audit-rate-limit-policy.mjs",
    "audit:job-contracts": "node scripts/audit-job-contracts.mjs",
    "audit:lib-boundaries": "node scripts/audit-lib-boundaries.mjs",
    "audit:package-graph": "node scripts/audit-package-graph.mjs",
    "audit:migration-safety": "node scripts/audit-migration-safety.mjs",
    "audit:e2e-rls-bootstrap": "node scripts/audit-e2e-rls-bootstrap.mjs",
    "check:nul-bytes": "node scripts/check-nul-bytes.mjs",
    "lint": "pnpm -r exec eslint .",
    "lint:check": "node scripts/check-lint-warnings.mjs",
    "typecheck": "turbo run typecheck",
    "typecheck:mobile": "pnpm --filter @alusa/mobile typecheck",
    "format": "prettier --write .",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@alusa/web",
    "build:clean": "pnpm --filter @alusa/web build:clean",
    "env:check:dev": "pnpm --filter @alusa/web env:check:dev",
    "dev": "pnpm env:check:dev && pnpm prisma:generate && pnpm exec turbo run build --filter=@alusa/web^... && pnpm --filter @alusa/web dev:raw",
    "dev:web": "pnpm env:check:dev && pnpm prisma:generate && pnpm exec turbo run build --filter=@alusa/web^... && pnpm -F @alusa/web dev:raw",
    "dev:mobile": "pnpm --filter @alusa/mobile dev",
    "dev:mobile:ios": "pnpm --filter @alusa/mobile ios",
    "dev:clean": "pnpm --filter @alusa/web dev:clean",
    "dev:prisma": "pnpm dlx prisma studio",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:unit:all": "pnpm -r --filter ./apps/web run test:unit",
    "test:unit": "pnpm --filter @alusa/web run test:unit",
    "test:unit:watch": "pnpm --filter @alusa/web run test:unit:watch",
    "test:e2e": "pnpm -r --filter ./apps/web run test:e2e",
    "e2e:prepare-rls": "node scripts/e2e/prepare-rls-role.mjs",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --name init --schema=prisma/schema.prisma",
    "db:migrate:local": "dotenv -e .env.local -- prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma --name matriculas",
    "db:migrate:matriculas": "prisma migrate dev --schema=prisma/schema.prisma --name matriculas",
    "db:seed": "prisma db seed --schema=prisma/schema.prisma",
    "db:migrate:test": "pnpm --filter @alusa/web run db:migrate:test",
    "db:reset:test": "pnpm --filter @alusa/web run db:reset:test",
    "db:seed:test": "pnpm --filter @alusa/web run db:seed:test",
    "events:map:migrate-document": "tsx scripts/migrate-event-map-documents.ts",
    "db:verify:test": "dotenv -e .env.test -- node scripts/verify-test-db.mjs",
    "mcp:asaas": "npx -y mcp-remote@0.1.38 https://docs.asaas.com/mcp",
    "sandbox:asaas:add-balance": "dotenv -e .env.local -- node scripts/asaas/sandbox-add-wallet-balance.mjs",
    "support:upsert-admin": "tsx scripts/support-upsert-admin-user.ts",
    "admin:upsert-user": "tsx scripts/support-upsert-admin-user.ts",
    "admin:backfill-users": "tsx scripts/admin/backfill-admin-users.ts",
    "security:check": "tsx scripts/security/run-all.ts",
    "validate:cron-config": "node scripts/validate-vercel-cron-config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.16.0",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pg": "^8.17.1",
    "postcss": "^8.5.26",
    "prisma": "5.18.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.28.0",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "overrides": {
      "pdfjs-dist": "5.4.296",
      "axios": "^1.16.1",
      "fast-xml-builder": "^1.2.0",
      "picomatch": "^4.0.4",
      "postcss": "^8.5.26",
      "preact": "^10.29.2",
      "qs": "^6.15.2",
      "uuid": "^11.1.1",
      "yaml": "^2.9.0"
    }
  },
  "dependencies": {
    "@alusa/admin-auth": "workspace:*",
    "@alusa/database": "workspace:*",
    "@luquinhasbrito/asaas-api-sdk-typescript": "^1.0.1",
    "@prisma/client": "5.18.0",
    "dotenv": "^17.2.3",
    "node-fetch": "^3.3.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
