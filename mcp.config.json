{
  "mcpServers": {
    "asaas": {
      "url": "https://docs.asaas.com/mcp"
    },
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "vercel-api": {
      "url": "https://mcp.vercel.com"
    },
    "hostinger-api": {
      "command": "npx",
      "args": [
        "dotenv",
        "-e",
        ".env",
        "--",
        "hostinger-api-mcp"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "DEBUG": "false"
      }
    }
  }
}
