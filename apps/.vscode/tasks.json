{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "web:typecheck",
			"type": "shell",
			"command": "pnpm --filter @alusa/web typecheck",
			"problemMatcher": ["$tsc"],
			"group": "build"
		},
		{
			"label": "web:test:unit",
			"type": "shell",
			"command": "pnpm --filter @alusa/web test:unit",
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "web:dev",
			"type": "shell",
			"command": "pnpm --filter @alusa/web dev:raw",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "mobile:typecheck",
			"type": "shell",
			"command": "pnpm --filter @alusa/mobile typecheck",
			"problemMatcher": ["$tsc"],
			"group": "build"
		}
	]
}
