# Example environment file for apps/web.
# Copy to apps/web/.env.local and fill values locally.
# Do not commit real secrets, tokens, passwords, or connection strings.

DATABASE_URL=
DIRECT_URL=

NODE_ENV=

NEXTAUTH_SECRET=
NEXTAUTH_URL=
APP_URL=
NEXT_PUBLIC_APP_URL=
# URL pública canônica do app (site + ERP no mesmo domínio). Em produção use https://alusa.app.

# Secret dedicado para assinar a sessão da Central de Suporte.
# Usuários administrativos são provisionados pelo script explícito.

ENCRYPTION_KEY=
# Versão da chave ativa. Mantenha estável por ambiente e altere somente durante rotação planejada.
ENCRYPTION_KEY_VERSION=1
# JSON opcional com chaves anteriores durante rotação: {"1":"<chave-anterior>"}
ENCRYPTION_KEYRING=

RESEND_API_KEY=
RESEND_FROM=
EMAIL_FROM_EVENTS=
EMAIL_FROM_AUTH=
EMAIL_FROM_INVITES=

ASAAS_API_KEY=
ASAAS_ENV=
ASAAS_BASE_URL=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_AUTH_TOKEN_SECRET=
ASAAS_WEBHOOK_PUBLIC_BASE_URL=
# Base pública HTTPS para provisionamento de webhooks Asaas.
# Em dev, use um túnel público (ngrok/Cloudflare) apontando para /api/webhooks/asaas.
# O Asaas considera sucesso somente HTTP 200; falhas repetidas podem pausar a fila.

FIN_WEBHOOK_ASYNC_ENABLED=
# Produção: processamento assíncrono obrigatório; deixe os dois valores abaixo vazios ou false.
FIN_WEBHOOK_INLINE_DRAIN=false
FIN_WEBHOOK_SYNC_OVERRIDE=false
ASAAS_WEBHOOK_STRICT_HTTP_REJECTIONS=true
# Local: FIN_WEBHOOK_ASYNC_ENABLED=true e, opcionalmente, inline drain=true para feedback imediato.

# WhatsApp Cloud API (canal institucional da Alusa; cobrança continua no Asaas).
# Nunca coloque o token no client, em commits ou em logs.
WHATSAPP_ENABLED=false
WHATSAPP_TEST_MODE=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEST_TEMPLATE_NAME=hello_world
WHATSAPP_TEST_TEMPLATE_LANGUAGE=en_US
# Lista E.164 separada por vírgulas. Em teste, somente estes números recebem mensagens.
WHATSAPP_TEST_ALLOWLIST=

FINANCE_GROUP_INSTALLMENTS_V2=
ASAAS_SYNC_THROTTLE_SECONDS=
ASAAS_SYNC_ENABLE_INMEM_CACHE=
ASAAS_SYNC_WRITE_ON_GET=
ASAAS_SYNC_ALLOW_ADMIN_RECONCILE=
NEXT_PUBLIC_BYPASS_PENDING_DOCUMENTS_BLOCK=

# Stripe cobra as assinaturas comerciais da plataforma Alusa.
# Não usar para cobranças educacionais de alunos/responsáveis.
STRIPE_ENVIRONMENT=TEST
STRIPE_SECRET_KEY=
STRIPE_API_VERSION=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
PLATFORM_BILLING_WORKER_SECRET=
PLATFORM_BILLING_INLINE_DRAIN=
# Desenvolvimento local somente: libera mutações sem ignorar billing em produção.
PLATFORM_BILLING_LOCAL_BYPASS=false

# Controles de limite da API Asaas. Redis é obrigatório em produção/múltiplas réplicas.
ASAAS_REDIS_ENABLED=true
ASAAS_REDIS_TIMEOUT_MS=1500
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ASAAS_MAX_CONCURRENT_GETS=45
ASAAS_GET_CONCURRENCY_WAIT_TIMEOUT_MS=10000
ASAAS_GET_LEASE_TTL_MS=60000
ASAAS_QUOTA_LIMIT=25000
ASAAS_QUOTA_REDIS_KEY_PREFIX=alusa:asaas:quota
ASAAS_GET_REDIS_KEY_PREFIX=alusa:asaas:get
ASAAS_WEBHOOK_RATE_LIMIT_REDIS_KEY_PREFIX=alusa:asaas:webhook-rate
ASAAS_DISTRIBUTED_GET_LIMIT_ENABLED=true

# Cache compartilhado do ERP. Necessário em produção com múltiplas réplicas;
# sem Redis, o cache de notificações usa fallback em memória por processo.
CACHE_LAYER_ENABLED=false
REDIS_CACHE_ENABLED=false
CACHE_DEBUG_HEADERS=false
NOTIFICATION_METRICS_VERBOSE=false

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Erros e performance (org alusa, projeto javascript-nextjs no Sentry).
# Mesmo DSN em client e server. /sentry-example-page existe para o passo Verify da documentação Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Upload de source maps no build (escopos: project:releases, org:read). Não commitar.
SENTRY_AUTH_TOKEN=
