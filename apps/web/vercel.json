{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs @alusa/web",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm prisma:generate && NODE_OPTIONS=--max-old-space-size=4096 pnpm exec turbo run build --filter=@alusa/web^... --concurrency=2 && pnpm --dir apps/web build:webpack",
  "crons": [
    {
      "path": "/api/jobs/platform-billing-maintenance?limit=100",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/webhook-scheduler?drainLimit=500&skipArchive=true&skipHealthCheck=true&skipDriftCheck=true",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/jobs/provision-asaas-subaccounts",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/jobs/reconcile-finance-webhooks?includeGaps=true&mode=targeted&providerCheckIntervalMinutes=360&limit=100&maxAccounts=20&maxAsaasCalls=100&accountConcurrency=2&maxDurationMs=100000",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/jobs/reconcile-payment-commands?limit=50&pollOlderThanSeconds=60&staleOlderThanMinutes=10",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/retry-enrollment-billing-provision?limit=25&minAgeMinutes=5",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/jobs/webhook-maintenance?autoRepair=true",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/jobs/archive-finance-webhooks",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/jobs/reconcile-stale-invoices?limit=50&staleOlderThanMinutes=60",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/jobs/reconcile-fiscal-settings?maxAccounts=30",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/jobs/reconcile-open-transfers?maxAccounts=30&limit=20&minAgeSeconds=60",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/jobs/reconcile-finance-accounts",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/jobs/reconcile-kyc-models",
      "schedule": "25 */2 * * *"
    },
    {
      "path": "/api/jobs/apply-asaas-notification-preferences?limit=50",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/jobs/process-asaas-notification-sync?limit=25",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/reconcile-asaas-customers?maxAccounts=20&limit=50",
      "schedule": "20 */3 * * *"
    },
    {
      "path": "/api/jobs/rebuild-billing-read-models?maxAccounts=30&limit=150",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/jobs/rebuild-billing-read-models?maxAccounts=10&limit=50&refreshRemote=true&remoteLimit=20&staleOlderThanMinutes=360",
      "schedule": "50 */6 * * *"
    },
    {
      "path": "/api/jobs/rebuild-finance-aggregates?maxAccounts=50&days=90",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/jobs/evaluate-financial-operational-health?maxAccounts=50",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/jobs/events-expire-reservations?maxAccounts=30&limit=100",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/events-reconcile-orders?maxAccounts=20&limit=50&olderThanMinutes=5",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/jobs/events-fulfill-tickets?maxAccounts=20&limit=100",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/jobs/process-ticket-email-outbox?limit=100",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/jobs/events-inspect-financial-inconsistencies?maxAccounts=30&limit=200",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/jobs/process-pending-inbox-notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/archive-low-value-notifications?olderThanDays=30&limit=500",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/jobs/process-overdue-billing-notifications",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/jobs/notify-contracts-expiring",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/jobs/encerrar-contratos?maxAccounts=100",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/jobs/expire-contract-links?maxAccounts=100&limit=500",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/jobs/reconcile-matricula-cancellations?maxAccounts=100&limit=100",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/rematriculas/run?maxAccounts=25&limit=25",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/whatsapp?outboxLimit=50&webhookLimit=100",
      "schedule": "* * * * *"
    }
  ]
}
