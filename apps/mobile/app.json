{
  "expo": {
    "name": "Alusa",
    "slug": "alusa-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alusa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.alusa.mobile",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3E1F63",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3E1F63",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Alusa precisa acessar suas fotos para atualizar sua foto de perfil.",
          "cameraPermission": "A Alusa precisa acessar a câmera para tirar sua foto de perfil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A Alusa precisa acessar a câmera para ler QR Codes de pagamentos, ingressos e fluxos da escola."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A Alusa usa o Face ID para proteger seu acesso."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
