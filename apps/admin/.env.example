# Banco compartilhado do monorepo. Nunca versionar valores reais.
DATABASE_URL="postgresql://user:password@host:5432/alusa"

# Rate limit distribuído obrigatório em produção.
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# Envio de convites administrativos para usuários das escolas.
RESEND_API_KEY="re_replace-me"
NEXT_PUBLIC_APP_URL="https://app.alusa.com.br"

# O Admin confia nos headers somente atrás de proxy controlado.
TRUST_PROXY_HEADERS="true"
RATE_LIMIT_DISABLE_IN_DEV="false"
